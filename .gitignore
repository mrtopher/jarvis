# macOS
.DS_Store

# Obsidian per-machine UI state
.obsidian/workspace.json
.obsidian/workspaces.json

# Shell history captured by lean-terminal plugin (may contain sensitive commands)
.obsidian/plugins/lean-terminal/shell-integration/.zsh_history

# lean-terminal plugin state: UI prefs + serialized terminal scrollback, churns every session
.obsidian/plugins/lean-terminal/data.json

# Repo sync: generated read-only mirrors of upstream repo docs (one per project)
00 Human/30 Projects/Ridgewells/repo-docs/
00 Human/30 Projects/Dual Logic Platform/repo-docs/
# Repo sync: per-machine last-run window (digest dedupes off the note itself)
Machine/Scripts/.repo-sync-state.json
